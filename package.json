{
  "name": "pmo-compass-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "format": "prettier --write 'frontend/src/**/*.{ts,tsx,css,json}' 'frontend/next.config.ts' 'e2e/*.ts' 'scripts/*.mjs' '*.ts'",
    "format:check": "prettier --check 'frontend/src/**/*.{ts,tsx,css,json}' 'frontend/next.config.ts' 'e2e/*.ts' 'scripts/*.mjs' '*.ts'",
    "test:a11y": "node scripts/audit-ui.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "record:demo": "node scripts/record-demo.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "typecheck": "npm run typecheck --workspace frontend",
    "check:docs": "node scripts/check-docs.mjs",
    "check:release": "npm run check:docs && node scripts/check-release.mjs",
    "test:release": "node --test scripts/check-release.test.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --project demo-pmo-compass --only firestore 'node --test firebase/tests/rules.test.mjs'",
    "test:firebase": "firebase emulators:exec --project demo-pmo-compass --only auth,firestore 'playwright test --config playwright.firebase.config.ts'",
    "check": "npm run lint && npm run typecheck && npm run test:api && npm run build",
    "test:providers": "playwright test --config playwright.providers.config.ts"
  },
  "overrides": {
    "express": {
      "qs": "^6.16.0"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "1.63.0",
    "firebase-tools": "^15.0.0",
    "prettier": "^3.9.6"
  }
}
