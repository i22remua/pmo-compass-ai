# demo: local templates; ollama: local model; external: unimplemented extension point.
AI_PROVIDER=demo
# demo is for local evaluation. Production must use firebase.
AUTH_MODE=demo
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=120
FIREBASE_PROJECT_ID=
# With AUTH_MODE=firebase, set GOOGLE_APPLICATION_CREDENTIALS to an absolute
# service-account JSON path outside this repository (or use ADC in hosting).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
RATE_LIMIT_PER_MINUTE=30
