# Reference only: applications load their own environment files.
# Current public URLs; Render remains an alternative in docs/deployment.md.
PUBLIC_FRONTEND_URL=https://pmo-compass-ai.vercel.app
PUBLIC_BACKEND_URL=https://pmo-compass-ai-api.vercel.app

NEXT_PUBLIC_DATA_MODE=demo
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set DATA_MODE to firebase and fill all four fields to enable real accounts.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Local Firebase integration testing only. Never enable in production.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Safe local defaults; production requires Firebase authentication.
AI_PROVIDER=auto
AI_PROVIDER_ORDER=gemini,groq,openrouter,offline
AI_COST_MODE=free_only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FREE_TIER_CONFIRMED=false
GROQ_API_KEY=
# Current free-plan model; llama-3.1-8b-instant is now listed as Enterprise.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FREE_TIER_CONFIRMED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
EXTERNAL_AI_TIMEOUT_SECONDS=20
FREE_AI_DAILY_LIMIT_PER_USER=20
FREE_AI_RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_MINUTE=30
AUTH_MODE=demo
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FIREBASE_PROJECT_ID=
# Server credentials only: set the secret-file path in the host environment.
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=120

# Optional backend-only credential JSON for Vercel Functions.
FIREBASE_SERVICE_ACCOUNT_JSON=
