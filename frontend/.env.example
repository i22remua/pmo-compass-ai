NEXT_PUBLIC_DATA_MODE=demo
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set DATA_MODE to firebase and fill all four fields to enable real accounts.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Public reCAPTCHA Enterprise site key. Configure it for App Check monitoring first.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# Local development only. Never enable in a production or preview environment.
NEXT_PUBLIC_FIREBASE_APP_CHECK_DEBUG=false
# Local Firebase integration testing only. Never enable in production.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
