rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(data) { return signedIn() && data.ownerId == request.auth.uid; }
    function text(value, maximum) { return value is string && value.size() <= maximum; }
    function language(value) { return value in ['es', 'en']; }
    function dateOrEmpty(value) {
      return value is string && (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function validProject(data) {
      return data.keys().hasAll(['ownerId', 'name', 'sector', 'description', 'objectives', 'startDate', 'endDate', 'status', 'budget', 'stakeholders', 'notes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'sector', 'description', 'objectives', 'startDate', 'endDate', 'status', 'budget', 'stakeholders', 'notes', 'createdAt', 'updatedAt', 'deleting', 'aiAccess'])
        && owner(data) && text(data.name, 120) && data.name.size() >= 2
        && text(data.sector, 80) && data.sector.size() >= 2
        && text(data.description, 5000) && text(data.objectives, 5000)
        && text(data.stakeholders, 4000) && text(data.notes, 20000)
        && dateOrEmpty(data.startDate) && dateOrEmpty(data.endDate)
        && (data.startDate == '' || data.endDate == '' || data.endDate >= data.startDate)
        && data.status in ['planning', 'active', 'at_risk', 'completed']
        && (data.budget == null || (data.budget is number && data.budget >= 0 && data.budget <= 1000000000000))
        && text(data.createdAt, 40) && text(data.updatedAt, 40)
        && (!('deleting' in data) || data.deleting is bool)
        && (!('aiAccess' in data) || data.aiAccess in ['offline', 'external']);
    }
    function activeParent(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId));
      return owner(project.data) && (!('deleting' in project.data) || !project.data.deleting);
    }
    function validDocument(data) {
      return data.keys().hasAll(['ownerId', 'projectId', 'type', 'language', 'inputContext', 'generatedContent', 'createdAt', 'provider', 'risks', 'warnings'])
        && data.keys().hasOnly(['ownerId', 'projectId', 'type', 'language', 'inputContext', 'generatedContent', 'createdAt', 'provider', 'risks', 'warnings'])
        && owner(data) && text(data.projectId, 128) && data.projectId.size() > 0
        && activeParent(data.projectId)
        && data.type in ['executive_brief', 'weekly_status', 'risk_register', 'meeting_minutes', 'action_items', 'stakeholder_email', 'scope_change', 'lessons_learned']
        && language(data.language) && text(data.inputContext, 12000)
        && text(data.generatedContent, 100000) && data.generatedContent.size() > 0
        && text(data.createdAt, 40) && data.provider in ['offline', 'gemini', 'groq', 'openrouter', 'demo', 'ollama', 'external']
        && data.risks is list && data.risks.size() <= 30
        && data.warnings is list && data.warnings.size() <= 20;
    }
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'preferredLanguage', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'preferredLanguage', 'createdAt'])
        && request.resource.data.uid == uid
        && text(request.resource.data.name, 100)
        && request.resource.data.email == request.auth.token.email
        && language(request.resource.data.preferredLanguage)
        && text(request.resource.data.createdAt, 40)
        && (resource == null || request.resource.data.createdAt == resource.data.createdAt);
    }
    match /projects/{id} {
      allow read, delete: if owner(resource.data);
      allow create: if validProject(request.resource.data) && (!('deleting' in request.resource.data) || !request.resource.data.deleting);
      allow update: if owner(resource.data) && validProject(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && (!('deleting' in resource.data) || !resource.data.deleting || request.resource.data.deleting == true);
    }
    match /documents/{id} {
      // Own orphaned documents remain readable/deletable for cleanup; creation needs an active owned parent.
      allow read, delete: if owner(resource.data);
      allow create: if validDocument(request.resource.data);
      // Identical retries are safe; saved content and ownership stay immutable.
      allow update: if owner(resource.data) && request.resource.data == resource.data;
    }
    function child(data) {
      return owner(data) && text(data.projectId, 128) && data.projectId.size() > 0
        && activeParent(data.projectId) && text(data.createdAt, 40);
    }
    match /sources/{id} {
      allow read, delete: if owner(resource.data);
      allow create: if child(request.resource.data)
        && request.resource.data.keys().hasAll(['ownerId', 'projectId', 'label', 'locator', 'text', 'reviewed', 'createdAt'])
        && request.resource.data.keys().hasOnly(['ownerId', 'projectId', 'label', 'locator', 'text', 'reviewed', 'createdAt'])
        && text(request.resource.data.label, 120) && request.resource.data.label.size() > 0
        && text(request.resource.data.locator, 80) && request.resource.data.locator.size() > 0
        && text(request.resource.data.text, 2000) && request.resource.data.text.size() > 0
        && request.resource.data.reviewed is bool;
      allow update: if owner(resource.data) && request.resource.data == resource.data;
    }
    function validRecord(data) {
      return child(data)
        && data.keys().hasAll(['ownerId', 'projectId', 'kind', 'title', 'status', 'dueDate', 'severity', 'evidence', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'projectId', 'kind', 'title', 'status', 'dueDate', 'severity', 'evidence', 'createdAt', 'updatedAt', 'id', 'ownerRole', 'closureCriteria', 'completionEvidence', 'revision', 'versionId'])
        && (!('ownerRole' in data) || text(data.ownerRole,120))
        && (!('closureCriteria' in data) || text(data.closureCriteria,1000))
        && (!('completionEvidence' in data) || text(data.completionEvidence,2000))
        && (!('revision' in data) || (data.revision is int && data.revision>=1 && text(data.versionId,128)))
        && data.kind in ['action', 'decision', 'risk'] && data.status in ['open', 'closed']
        && text(data.title, 300) && data.title.size() >= 2
        && dateOrEmpty(data.dueDate) && (data.kind != 'risk' || data.dueDate == '')
        && data.severity in ['unspecified', 'low', 'medium', 'high'] && (data.kind == 'risk' || data.severity == 'unspecified')
        && text(data.evidence, 2000) && text(data.updatedAt, 40);
    }
    match /records/{id} {
      allow read, delete: if owner(resource.data);
      allow create: if validRecord(request.resource.data) && (!('revision' in request.resource.data) || (request.resource.data.revision==1 && recordVersionMatches(request.resource.data,id)));
      allow update: if owner(resource.data) && validRecord(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.createdAt == resource.data.createdAt
        && ((!('revision' in resource.data) && !('revision' in request.resource.data)) ||
          (request.resource.data.revision == resource.data.get('revision',0)+1 && recordVersionMatches(request.resource.data,id)));
    }
    function recordVersionMatches(data,id) {
      let v=getAfter(/databases/$(database)/documents/recordVersions/$(data.versionId)).data;
      return v.id==id && v.diff(data).affectedKeys().hasOnly(['id']);
    }
    match /recordVersions/{versionId} {
      allow read: if owner(resource.data);
      allow create: if validRecord(request.resource.data) && request.resource.data.versionId==versionId
        && request.resource.data.diff(getAfter(/databases/$(database)/documents/records/$(request.resource.data.id)).data).affectedKeys().hasOnly(['id']);
      allow update: if false;
      allow delete: if deletingControlParent(resource.data);
    }
    function validReview(data, id) {
      return child(data) && data.projectId == id
        && data.keys().hasAll(['ownerId', 'projectId', 'language', 'engine', 'contextKey', 'payload', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'projectId', 'language', 'engine', 'contextKey', 'payload', 'createdAt', 'updatedAt'])
        && language(data.language) && data.engine == 'offline'
        && data.contextKey is string && data.contextKey.matches('^[a-f0-9]{64}$')
        && text(data.payload, 180000) && data.payload.size() > 0 && text(data.updatedAt, 40);
    }
    match /reviews/{id} {
      allow get: if owner(resource.data) || (resource == null && activeParent(id));
      allow list, delete: if owner(resource.data);
      allow create: if validReview(request.resource.data, id);
      allow update: if owner(resource.data) && validReview(request.resource.data, id)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    function controlDate(value, required) {
      return value is string && ((!required && value == '') ||
        (value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && (!(value.split('-')[1] in ['04', '06', '09', '11']) || int(value.split('-')[2]) <= 30)
          && (value.split('-')[1] != '02' || int(value.split('-')[2]) <= 28 ||
            (int(value.split('-')[2]) == 29 && int(value.split('-')[0]) % 4 == 0 &&
              (int(value.split('-')[0]) % 100 != 0 || int(value.split('-')[0]) % 400 == 0)))));
    }
    function controlAmount(value, signed) {
      return value == null || (value is number && value <= 1000000000000 && value >= (signed ? -1000000000000 : 0));
    }
    function decisionData(d, evidence) {
      return d.keys().hasOnly(['status', 'reason', 'alternatives', 'scopeImpact', 'timeImpact', 'costImpact', 'baseline', 'resolution', 'decidedOn', 'decisionRole', 'requiredRole', 'dueDate', 'deliveryId'])
        && (!('requiredRole' in d) || text(d.requiredRole,120))
        && (!('dueDate' in d) || controlDate(d.dueDate,false))
        && (!('deliveryId' in d) || text(d.deliveryId,128))
        && d.status in ['proposed', 'reviewed', 'accepted', 'rejected']
        && text(d.reason, 2000) && d.reason.size() >= 2 && text(d.alternatives, 2000)
        && text(d.scopeImpact, 2000) && text(d.timeImpact, 2000) && text(d.costImpact, 2000)
        && text(d.baseline, 2000) && text(d.resolution, 2000) && text(d.decisionRole, 120)
        && (d.status == 'proposed' || d.alternatives.size() >= 2)
        && ((d.status in ['accepted', 'rejected'] && controlDate(d.decidedOn, true)
          && d.resolution.size() >= 2 && d.decisionRole.size() >= 2 && evidence.size() > 0)
          || (d.status in ['proposed', 'reviewed'] && d.decidedOn == '' && d.resolution == '' && d.decisionRole == ''));
    }
    function controlData(c) {
      let d = c.data;
      return d is map && (
        (c.kind in ['change', 'decision'] && decisionData(d, c.evidence)) ||
        (c.kind == 'milestone' && d.keys().hasOnly(['baselineDate', 'forecastDate', 'actualDate', 'dependency'])
          && controlDate(d.baselineDate, true) && controlDate(d.forecastDate, false) && controlDate(d.actualDate, false) && text(d.dependency, 1000)) ||
        (c.kind == 'cost' && d.keys().hasOnly(['approved', 'actual', 'forecast', 'asOf', 'scope']) && (!('scope' in d) || text(d.scope,160))
          && controlAmount(d.approved, false) && controlAmount(d.actual, false) && controlAmount(d.forecast, false)
          && controlDate(d.asOf, true) && (d.actual == null || c.evidence.size() > 0)) ||
        (c.kind == 'benefit' && d.keys().hasOnly(['objective', 'unit', 'baseline', 'target', 'actual', 'measuredOn', 'direction'])
          && text(d.objective, 1000) && d.objective.size() >= 2 && text(d.unit, 80) && d.unit.size() > 0
          && d.direction in ['increase', 'decrease'] && controlAmount(d.baseline, true) && controlAmount(d.target, true) && controlAmount(d.actual, true)
          && ((d.actual == null && d.measuredOn == '') || (d.actual != null && controlDate(d.measuredOn, true) && c.evidence.size() > 0)))
      );
    }
    function validControl(c, id) {
      return c.keys().hasAll(['id', 'ownerId', 'projectId', 'kind', 'title', 'evidence', 'recordId', 'archived', 'data', 'revision', 'versionId', 'createdAt', 'updatedAt'])
        && c.keys().hasOnly(['id', 'ownerId', 'projectId', 'kind', 'title', 'evidence', 'recordId', 'archived', 'data', 'revision', 'versionId', 'createdAt', 'updatedAt'])
        && c.id == id && text(id, 128) && id.size() > 0 && owner(c) && activeParent(c.projectId)
        && text(c.projectId, 128) && text(c.title, 160) && c.title.size() >= 2 && text(c.evidence, 2000)
        && text(c.recordId, 128) && (c.recordId == '' ||
          (owner(get(/databases/$(database)/documents/records/$(c.recordId)).data)
            && get(/databases/$(database)/documents/records/$(c.recordId)).data.projectId == c.projectId))
        && c.archived is bool && c.revision is int && c.revision >= 1
        && text(c.versionId, 128) && c.versionId.size() > 0
        && c.createdAt is timestamp && c.updatedAt == request.time && controlData(c)
        && (!(c.kind in ['change','decision']) || !('deliveryId' in c.data) || c.data.deliveryId=='' || validDelivery(c));
    }
    function validDelivery(c) {
      let linked=get(/databases/$(database)/documents/controls/$(c.data.deliveryId)).data;
      return owner(linked) && linked.projectId==c.projectId && linked.kind=='milestone' && !linked.archived;
    }
    function controlTransition(old, next) {
      return old.kind == next.kind && (
        !(old.kind in ['change', 'decision']) ||
        (old.data.status == 'proposed' && next.data.status in ['proposed', 'reviewed']) ||
        (old.data.status == 'reviewed' && next.data.status in ['reviewed', 'accepted', 'rejected']) ||
        (old.data.status in ['accepted', 'rejected'] && next.data.status == old.data.status))
        && (old.kind != 'milestone' || old.data.baselineDate == next.data.baselineDate);
    }
    function deletingControlParent(data) {
      return owner(data) && (!exists(/databases/$(database)/documents/projects/$(data.projectId)) ||
        (owner(get(/databases/$(database)/documents/projects/$(data.projectId)).data)
          && get(/databases/$(database)/documents/projects/$(data.projectId)).data.deleting == true));
    }
    match /controls/{id} {
      allow read: if owner(resource.data);
      allow create: if validControl(request.resource.data, id) && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time
        && (!(request.resource.data.kind in ['change', 'decision']) || request.resource.data.data.status == 'proposed')
        && getAfter(/databases/$(database)/documents/controlVersions/$(request.resource.data.versionId)).data == request.resource.data;
      allow update: if owner(resource.data) && validControl(request.resource.data, id)
        && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.versionId != resource.data.versionId && controlTransition(resource.data, request.resource.data)
        && getAfter(/databases/$(database)/documents/controlVersions/$(request.resource.data.versionId)).data == request.resource.data;
      allow delete: if deletingControlParent(resource.data);
    }
    match /controlVersions/{versionId} {
      allow read: if owner(resource.data);
      allow create: if request.resource.data.versionId == versionId
        && validControl(request.resource.data, request.resource.data.id)
        && getAfter(/databases/$(database)/documents/controls/$(request.resource.data.id)).data == request.resource.data;
      allow update: if false;
      allow delete: if deletingControlParent(resource.data);
    }

    match /reviewHistory/{id} {
      allow get: if owner(resource.data) || (resource == null && signedIn());
      allow list: if owner(resource.data);
      allow create: if validReview(request.resource.data, request.resource.data.projectId)
        && id == request.resource.data.projectId + '--' + request.resource.data.contextKey
        && (request.resource.data == getAfter(/databases/$(database)/documents/reviews/$(request.resource.data.projectId)).data
          || request.resource.data == get(/databases/$(database)/documents/reviews/$(request.resource.data.projectId)).data);
      allow update: if false;
      allow delete: if deletingControlParent(resource.data);
    }
    function validFinding(d,id) {
      return child(d) && d.keys().hasOnly(['id','ownerId','projectId','findingId','fingerprint','status','reason','revision','versionId','createdAt','updatedAt'])
        && d.id==id && id==d.projectId+'--'+d.findingId
        && d.findingId is string && d.findingId.matches('^[a-z0-9:-]{1,100}$')
        && d.fingerprint is string && d.fingerprint.matches('^[a-f0-9]{64}$')
        && d.status in ['pending','confirmed','dismissed'] && text(d.reason,2000) && d.reason.size()>0
        && d.revision is int && d.revision>0 && text(d.versionId,128) && d.versionId.size()>0 && text(d.updatedAt,40);
    }
    match /findingStates/{id} {
      allow get: if owner(resource.data) || (resource==null && signedIn());
      allow list: if owner(resource.data);
      allow create: if validFinding(request.resource.data,id) && request.resource.data.revision==1
        && getAfter(/databases/$(database)/documents/findingVersions/$(request.resource.data.versionId)).data==request.resource.data;
      allow update: if owner(resource.data) && validFinding(request.resource.data,id)
        && request.resource.data.projectId==resource.data.projectId && request.resource.data.createdAt==resource.data.createdAt
        && request.resource.data.revision==resource.data.revision+1 && request.resource.data.versionId!=resource.data.versionId
        && getAfter(/databases/$(database)/documents/findingVersions/$(request.resource.data.versionId)).data==request.resource.data;
      allow delete: if deletingControlParent(resource.data);
    }
    match /findingVersions/{id} {
      allow read: if owner(resource.data);
      allow create: if validFinding(request.resource.data,request.resource.data.id) && request.resource.data.versionId==id
        && getAfter(/databases/$(database)/documents/findingStates/$(request.resource.data.id)).data==request.resource.data;
      allow update: if false;
      allow delete: if deletingControlParent(resource.data);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
